rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth helper
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check role from Firestore 'user' collection (Singular)
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/user/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Allow users to read/write their own user doc in 'user' collection
    match /user/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /cartons/{cartonId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /carton_rows/{rowId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAdmin() || (resource.data.createdBy == request.auth.token.email && resource.data.cartonId == null);
    }
    
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
